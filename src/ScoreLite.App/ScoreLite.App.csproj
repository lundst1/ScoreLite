<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- iOS byggs bara på en Mac (kräver Xcode). Kod för iOS finns men är inte kompilerad i den här miljön. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>ScoreLite.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>ScoreLite</ApplicationTitle>
		<ApplicationId>com.scorelite.app</ApplicationId>
		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<AllowUnsafeBlocks Condition="'$(TargetFramework)' == 'net10.0-ios'">true</AllowUnsafeBlocks>

		<!-- DR-21: Android API 26, iOS 15 -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>

		<!-- N2: liten APK. Ljudfonten (.sf2) är redan komprimerad data men packas ändå av aapt; Verovio-JS komprimeras bra. -->
		<AndroidPackageFormats>apk</AndroidPackageFormats>
		<AndroidStoreUncompressedFileExtensions>.sf2</AndroidStoreUncompressedFileExtensions>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1F3A5F" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F3A5F" BaseSize="128,128" />
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Rå resurser: wwwroot (HybridWebView), ljudfonten och licenstexter -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<ProjectReference Include="..\ScoreLite.App.Core\ScoreLite.App.Core.csproj" />
		<ProjectReference Include="..\ScoreLite.Audio\ScoreLite.Audio.csproj" />
		<ProjectReference Include="..\ScoreLite.Core\ScoreLite.Core.csproj" />
	</ItemGroup>

	<!-- Ljudfonten checkas inte in (K14, decisions.md #17). Hämta den med tools/fetch-soundfont.sh. -->
	<Target Name="CheckSoundFont" BeforeTargets="BeforeBuild">
		<Warning Condition="!Exists('$(MSBuildProjectDirectory)\Resources\Raw\soundfont.sf2')"
		         Text="Resources/Raw/soundfont.sf2 saknas. Kör tools/fetch-soundfont.sh src/ScoreLite.App/Resources/Raw. Appen startar utan ljud." />
	</Target>

</Project>
